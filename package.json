{
  "name": "poppin-browser",
  "productName": "Poppin Browser",
  "version": "0.1.0",
  "description": "A calm, browser-first workspace for building with Codex.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run package && vitest run --config vitest.smoke.config.mts",
    "test:codex-live": "POPPIN_RUN_LIVE_CODEX=1 vitest run tests/codex-live.test.ts --testTimeout=240000",
    "screenshot:checkpoint-a": "node scripts/capture-checkpoint-a.mjs",
    "screenshot:checkpoint-b": "node scripts/capture-checkpoint-b.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.2",
    "electron": "^43.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.3.0",
    "playwright-core": "^1.57.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
